{
  "compilerOptions": {
    "module": "CommonJS",
    "baseUrl": ".",
    "target": "es6",
    "rootDir": "./src",
    "paths": {
      "@components": ["./src/components/*"],
      "@styles/*": ["./src/styles/*"],
      "@pages/*": ["./src/pages/*"],
      "@images/*": ["./src/images/*"],
      "@mock/*": ["./src/mock/*"],
      "@hooks/*": ["./src/hooks/*"],
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}